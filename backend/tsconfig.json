{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*"],
  // Tests run from source via tsx (`npm test`) and have no business in
  // the production image, so they're kept out of the dist build.
  // `npm run typecheck` still checks them — see the tsconfig.test.json.
  "exclude": ["src/**/*.test.ts"]
}
