{
  // Type-checks the test files too. The main tsconfig.json excludes them
  // so they never land in dist/ (the production image doesn't ship tsx or
  // the node:test harness), but we still want them type-checked in CI and
  // before a commit — `npm run typecheck` runs both configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": []
}
