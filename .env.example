# ============================================================
#  azure-mcp — environment template
#  Copy to `.env` and fill in real values. `.env` is gitignored.
#  The backend validates every required var on startup and
#  exits loudly if any are missing.
# ============================================================

# ─── Anthropic ────────────────────────────────────────────────
# API key for Claude. Generate at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model id used for chat orchestration. Opus 4.7 is the most capable;
# Sonnet 4.6 is faster and cheaper for tighter loops.
ANTHROPIC_MODEL=claude-opus-4-7

# ─── Azure (service principal — full subscription Contributor) ────
# Steven: see DECISIONS.md "Azure service principal" section for the
# exact `az ad sp create-for-rbac` commands used to mint these.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# ─── Postgres ─────────────────────────────────────────────────
# These match the docker-compose service names; only POSTGRES_PASSWORD
# needs filling in for local dev.
POSTGRES_HOST=azure-mcp-db
POSTGRES_PORT=5432
POSTGRES_DB=azuremcp
POSTGRES_USER=azuremcp
POSTGRES_PASSWORD=

# ─── App ──────────────────────────────────────────────────────
# Public URL the tunnel terminates at. Used for CORS and link generation.
PUBLIC_URL=https://azure-mcp.clydeford.net

# Cloudflare Access asserts the user's email in the
# `Cf-Access-Authenticated-User-Email` header. The backend rejects any
# request whose email does not match this value. Single-user tool.
TRUSTED_USER_EMAIL=

# Container ports (rarely need to change).
PORT_BACKEND=3000
PORT_FRONTEND=8080
