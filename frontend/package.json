    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/react": "^12.3.6",
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-beta.8",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0-beta.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
