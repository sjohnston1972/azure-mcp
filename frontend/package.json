{
  "name": "azure-mcp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React + Vite + Tailwind 4 SPA. Two-pane workspace: topology canvas (React Flow) on the left, Claude chat on the right. Visual style mirrors netbud (see DECISIONS.md).",
