# ─── Secrets ──────────────────────────────────────────────────────
# Real .env contains live API keys and Azure SP credentials. NEVER commit it.
# Only .env.example (placeholder values) is committed.
.env
.env.local
.env.*.local

# ─── Node / JS / TS ───────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Editor / OS ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ─── Build artefacts ──────────────────────────────────────────────
*.tsbuildinfo
coverage/

# ─── Postgres data (named volume should hold it; this is belt-and-braces) ──
db/data/
postgres-data/

# ─── Local Compose overrides (committed copy is .yml.example) ─────
docker-compose.override.yml

# ─── Screenshot tooling artefacts (the script itself is checked in) ─
docs/screenshots/node_modules
docs/screenshots/package*.json

# ─── Misc ─────────────────────────────────────────────────────────
.tmp/
tmp/

# ─── Debug paste artefacts ────────────────────────────────────────
# Chat transcripts the user pastes locally for debugging — keep out
# of the repo so they don't accumulate as project history.
issue logs/

# ─── Claude Code session state ────────────────────────────────────
# Scratch dir Claude Code creates per-session (scheduled_tasks.lock,
# etc). Not a project asset — keep out of the repo.
.claude/
